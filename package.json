{
  "name": "champions-vgc-builder",
  "private": true,
  "version": "0.1.0",
  "description": "Montador de equipes VGC para Pokémon Champions com sugestões baseadas em dados de torneios, ladder e teoria de team building.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "update:dex": "tsx scripts/update-dex.ts",
    "update:meta": "tsx scripts/update-meta.ts",
    "update-data": "tsx scripts/update-dex.ts && tsx scripts/update-meta.ts",
    "sugerir": "tsx scripts/cli.ts"
  },
  "dependencies": {
    "@smogon/calc": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
